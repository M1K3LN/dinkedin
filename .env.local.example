# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Service role key is server-only. Do NOT expose with NEXT_PUBLIC_*.
# Not required for Phase 1; needed in Phase 4 (Shopify, admin server tasks).
SUPABASE_SERVICE_ROLE_KEY=

# Used for OAuth/email-link callbacks. Set to your deployed Vercel URL in prod.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
